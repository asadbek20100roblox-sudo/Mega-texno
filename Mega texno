        const COLS = ['categories', 'products', 'sales', 'debts', 'contacts', 'expenses', 'staff'];
        const CLOUD_ROOT = 'megatexno/v3';
        const LEGACY_PATH = 'megatexno_sklad_data';
        const DEFAULT_FIREBASE_CONFIG = {
            apiKey: "AIzaSyCLb5G1CowJf5ZlaKHf_5yhDEXYvN2b8zM",
            authDomain: "megatexno-8e999.firebaseapp.com",
            databaseURL: "https://megatexno-8e999-default-rtdb.asia-southeast1.firebasedatabase.app",
            projectId: "megatexno-8e999",
            storageBucket: "megatexno-8e999.firebasestorage.app",
