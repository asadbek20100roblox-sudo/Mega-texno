        let pushQueue = Promise.resolve();

        function snapshotOf(d) {
            const s = { exchangeRate: d.exchangeRate, catsSeeded: !!d.catsSeeded };
            COLS.forEach(c => { s[c] = {}; (d[c] || []).forEach(x => { if (x && x.id) s[c][x.id] = JSON.parse(JSON.stringify(x)); }); });
            return s;
