                return Object.assign(JSON.parse(JSON.stringify(initialData)), JSON.parse(raw));
            } catch (e) { return JSON.parse(JSON.stringify(initialData)); }
        }

        function catId(name) { return 'c_' + sha256('cat|' + name.toLowerCase()).slice(0, 10); }
        function seedCategories() {
            const have = new Set(db.categories.map(c => c.name.toLowerCase()));
            const add = n => { n = (n || '').trim(); if (n && !have.has(n.toLowerCase())) { have.add(n.toLowerCase()); db.categories.push({ id: catId(n), name: n }); } };
            db.products.forEach(p => add(p.category));
            if (!db.catsSeeded) { ['Telefon', 'Konditsioner', 'Muzlatgich (Xolodilnik)', 'Gaz plita', 'Televizor', 'Stiralka'].forEach(add); db.catsSeeded = true; }
        }
        function esc(v) { return String(v == null ? '' : v).replace(/[&<>"']/g, ch => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[ch])); }

        function ensureAdminAccount() {
