        function printLabels(jobs, cfg) {
            ensureCodes();
            const a4 = cfg.fmt === 'a4', { w, h } = cfgSize(cfg);
            const html = jobs.map(({ p, n }) => {
                const src = labelCanvas(p, w, h, 16).toDataURL('image/png');
