<!DOCTYPE html>
<html lang="uz">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Mega Texno — Umumiy Baza</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Firebase SDK (Compat v9) for Realtime Database -->
    <script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-database-compat.js"></script>
    <!-- Fonts & Icons -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <!-- QR: yaratish va o'qish -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcode-generator/1.4.4/qrcode.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jsQR/1.4.0/jsQR.min.js"></script>
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f1f5f9;
            color: #0f172a;
            margin: 0;
            padding: 0;
            -webkit-tap-highlight-color: transparent;
        }
        .sidebar-bg {
            background: linear-gradient(180deg, #092c22 0%, #0d3b2e 50%, #07221a 100%);
        }
        .login-bg {
            background: radial-gradient(circle at top right, #1f8a65 0%, #0d3b2e 45%, #061c16 100%);
        }
        .nav-item {
            color: #99bfb3;
            font-weight: 500;
            transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .nav-item:hover {
            background-color: rgba(255, 255, 255, 0.08);
            color: #ffffff;
            transform: translateX(2px);
        }
        .nav-item.active {
            background: linear-gradient(135deg, #229971 0%, #156e4f 100%);
            color: #ffffff;
            font-weight: 600;
            box-shadow: 0 4px 12px rgba(21, 110, 79, 0.35);
        }
        .hero-kassa {
            background: linear-gradient(135deg, #0f172a 0%, #1e293b 55%, #0f3d2e 100%);
            position: relative;
            overflow: hidden;
        }
        .hero-kassa::after {
            content: '';
            position: absolute;
            right: -40px;
            top: -40px;
            width: 180px;
            height: 180px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(34, 197, 94, 0.18) 0%, transparent 70%);
            pointer-events: none;
        }
        .btn-teal {
            background: linear-gradient(135deg, #1b7a58 0%, #11543c 100%);
            color: #ffffff;
            transition: all 0.2s ease;
            box-shadow: 0 4px 10px rgba(20, 94, 75, 0.22);
        }
        .btn-teal:hover {
            background: linear-gradient(135deg, #218f68 0%, #146347 100%);
            box-shadow: 0 6px 14px rgba(20, 94, 75, 0.32);
            transform: translateY(-1px);
        }
        .btn-teal:active {
            transform: scale(0.98);
        }
        .stat-card {
            background: #ffffff;
            border: 1px solid rgba(226, 232, 240, 0.9);
            border-radius: 1rem;
            transition: all 0.2s ease;
        }
        .stat-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 25px -5px rgba(15, 23, 42, 0.06);
        }
        /* ===== QR skaner ===== */
        .scan-frame { box-shadow: 0 0 0 9999px rgba(0,0,0,.55); }
        .scan-line { animation: scanmove 2s ease-in-out infinite alternate; }
        @keyframes scanmove { from { top: 6%; } to { top: 92%; } }
        .flash-field { animation: flashf 1.2s ease; }
        @keyframes flashf { 0%,100% { box-shadow: 0 0 0 0 rgba(31,138,101,0); } 30% { box-shadow: 0 0 0 4px rgba(31,138,101,.45); } }
        /* ===== QR chop etish ===== */
        #qr-print-area { display: none; }
        .qr-label { box-sizing: border-box; display: flex; align-items: center; justify-content: center; overflow: hidden; background: #fff; color: #000; font-family: Arial, Helvetica, sans-serif; break-after: page; page-break-after: always; }
        .qr-label:last-child { break-after: auto; page-break-after: auto; }
        .qr-label.col { flex-direction: column; }
        .qr-label.row { flex-direction: row; }
        .qr-label img { display: block; image-rendering: auto; flex-shrink: 0; }
        .qr-label .qr-name { font-weight: 700; line-height: 1.1; text-align: center; word-break: break-word; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
        .qr-label.row .qr-name { text-align: left; -webkit-line-clamp: 4; }
        #qr-print-area.a4 { display: none; flex-wrap: wrap; align-content: flex-start; }
        .qr-label.a4 { break-after: auto; page-break-after: auto; break-inside: avoid; border: 0.2mm dashed #999; }
        @media print {
            body > *:not(#qr-print-area) { display: none !important; }
            body { display: block !important; background: #fff !important; min-height: 0 !important; overflow: visible !important; }
            #qr-print-area { display: block !important; }
            #qr-print-area.a4 { display: flex !important; }
        }
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #f1f5f9;
        }
        ::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 4px;
        }
    </style>
</head>
<body class="min-h-screen flex flex-col md:flex-row overflow-x-hidden">

    <!-- ================= LOGIN SCREEN ================= -->
    <div id="login-screen" class="fixed inset-0 z-50 login-bg flex items-center justify-center p-4">
        <div class="bg-white/95 backdrop-blur-xl rounded-3xl shadow-2xl border border-white/20 w-full max-w-sm p-7 sm:p-8 transition-all">
            <div class="flex flex-col items-center text-center mb-7">
                <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-[#24a177] to-[#125840] flex items-center justify-center text-white text-2xl shadow-lg shadow-emerald-900/30 mb-3.5 ring-4 ring-emerald-50">
                    <i class="fa-solid fa-cube"></i>
                </div>
                <h1 class="text-2xl font-extrabold text-slate-900 tracking-tight">Mega Texno</h1>
                <p class="text-xs text-slate-500 font-medium mt-1">Umumiy Baza · Realtime DB Tizim</p>
            </div>

            <form id="login-form" class="space-y-4">
                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1.5 ml-0.5">Login</label>
                    <div class="relative">
                        <i class="fa-solid fa-user absolute left-4 top-3.5 text-slate-400 text-xs"></i>
                        <input type="text" id="login-username" placeholder="Loginni kiriting" required autocomplete="username"
                            class="w-full pl-10 pr-4 py-3 bg-slate-50/90 border border-slate-200 rounded-xl text-sm font-medium text-slate-800 placeholder:text-slate-400 focus:outline-none focus:bg-white focus:border-[#1f8a65] focus:ring-4 focus:ring-emerald-500/10 transition">
                    </div>
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1.5 ml-0.5">Parol</label>
                    <div class="relative">
                        <i class="fa-solid fa-lock absolute left-4 top-3.5 text-slate-400 text-xs"></i>
                        <input type="password" id="login-password" placeholder="Parolni kiriting" required autocomplete="current-password"
                            class="w-full pl-10 pr-10 py-3 bg-slate-50/90 border border-slate-200 rounded-xl text-sm font-medium text-slate-800 placeholder:text-slate-400 focus:outline-none focus:bg-white focus:border-[#1f8a65] focus:ring-4 focus:ring-emerald-500/10 transition">
                        <button type="button" onclick="toggleLoginPass()" class="absolute right-3.5 top-3 text-slate-400 hover:text-slate-600 text-xs p-1">
                            <i id="login-eye" class="fa-solid fa-eye"></i>
                        </button>
                    </div>
                </div>

                <div id="login-error" class="hidden bg-red-50 border border-red-200 text-red-600 text-xs font-semibold px-3.5 py-2.5 rounded-xl flex items-center gap-2">
                    <i class="fa-solid fa-circle-exclamation"></i>
                    <span id="login-error-text">Login yoki parol noto'g'ri!</span>
                </div>

                <div class="pt-1">
                    <button type="submit" class="w-full btn-teal py-3.5 rounded-xl font-bold text-sm flex items-center justify-center gap-2">
                        <i class="fa-solid fa-right-to-bracket"></i>
                        <span>Tizimga kirish</span>
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- ================= MOBILE DRAWER BACKDROP ================= -->
    <div id="sidebar-backdrop" onclick="closeMobileSidebar()" class="fixed inset-0 bg-slate-950/60 backdrop-blur-xs z-30 hidden md:hidden transition-opacity"></div>

    <!-- ================= LEFT SIDEBAR ================= -->
    <aside id="sidebar" class="sidebar-bg fixed md:static inset-y-0 left-0 z-40 w-64 flex-shrink-0 flex flex-col justify-between transform -translate-x-full md:translate-x-0 transition-transform duration-200 ease-in-out select-none shadow-2xl md:shadow-none">
        <div>
            <!-- Brand Header -->
            <div class="p-4.5 px-5 py-4 flex items-center justify-between border-b border-white/10">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-[#28ad80] to-[#177052] flex items-center justify-center text-white shadow-md flex-shrink-0">
                        <i class="fa-solid fa-cube text-base"></i>
                    </div>
                    <div>
                        <div class="text-white font-extrabold text-base leading-tight tracking-tight">Mega Texno</div>
                        <div class="text-[#8ab5a8] text-[11px] font-medium">Umumiy Baza · Sklad</div>
                    </div>
                </div>
                <button onclick="closeMobileSidebar()" class="md:hidden text-white/70 hover:text-white p-1.5">
                    <i class="fa-solid fa-xmark text-lg"></i>
                </button>
            </div>

            <!-- Navigation Items -->
            <nav class="p-3.5 space-y-1.5">
                <button onclick="switchTab('bosh')" id="nav-bosh" class="nav-item active w-full flex items-center gap-3.5 px-4 py-3 rounded-xl text-sm">
                    <i class="fa-solid fa-chart-pie w-5 text-center"></i>
                    <span>Bosh sahifa</span>
                </button>
                <button onclick="switchTab('ombor')" id="nav-ombor" class="nav-item w-full flex items-center gap-3.5 px-4 py-3 rounded-xl text-sm">
                    <i class="fa-solid fa-box-archive w-5 text-center"></i>
                    <span>Ombor</span>
                </button>
                <button onclick="switchTab('harakat')" id="nav-harakat" class="nav-item w-full flex items-center gap-3.5 px-4 py-3 rounded-xl text-sm">
                    <i class="fa-solid fa-arrows-up-down w-5 text-center"></i>
                    <span>Harakat (Sotuv)</span>
                </button>
                <button onclick="switchTab('qarz')" id="nav-qarz" class="nav-item w-full flex items-center gap-3.5 px-4 py-3 rounded-xl text-sm">
                    <i class="fa-solid fa-hand-holding-dollar w-5 text-center"></i>
                    <span>Qarz daftari</span>
                </button>
                <button onclick="switchTab('kontakt')" id="nav-kontakt" class="nav-item w-full flex items-center gap-3.5 px-4 py-3 rounded-xl text-sm">
                    <i class="fa-solid fa-address-book w-5 text-center"></i>
                    <span>Kontaktlar</span>
                </button>
                <button onclick="switchTab('xarajat')" id="nav-xarajat" class="nav-item w-full flex items-center gap-3.5 px-4 py-3 rounded-xl text-sm">
                    <i class="fa-solid fa-receipt w-5 text-center"></i>
                    <span>Xarajatlar</span>
                </button>
                <button onclick="switchTab('hisobot')" id="nav-hisobot" class="nav-item w-full flex items-center gap-3.5 px-4 py-3 rounded-xl text-sm">
                    <i class="fa-solid fa-chart-column w-5 text-center"></i>
                    <span>Hisobotlar</span>
                </button>
                <button onclick="switchTab('xodim')" id="nav-xodim" class="nav-item w-full flex items-center gap-3.5 px-4 py-3 rounded-xl text-sm">
                    <i class="fa-solid fa-user-gear w-5 text-center"></i>
                    <span>Xodimlar</span>
                </button>
            </nav>
        </div>

        <!-- Sidebar Footer -->
        <div class="p-4 border-t border-white/10 space-y-2.5">
            <div class="text-[11px] text-[#8ab5a8]/80 text-center font-medium">Mega Texno</div>
        </div>
    </aside>

    <!-- ================= MAIN CONTENT WRAPPER ================= -->
    <div class="flex-1 flex flex-col min-w-0 w-full">

        <!-- TOP HEADER -->
        <header class="bg-white/90 backdrop-blur-md border-b border-slate-200/80 px-3.5 sm:px-6 py-2.5 flex items-center justify-between gap-2 sticky top-0 z-20">
            <div class="flex items-center gap-3">
                <button onclick="openMobileSidebar()" class="md:hidden w-9 h-9 rounded-xl bg-slate-100 hover:bg-slate-200 flex items-center justify-center text-slate-700 transition">
                    <i class="fa-solid fa-bars text-base"></i>
                </button>
                <div>
                    <div class="flex items-center gap-2">
                        <h1 class="text-sm sm:text-base font-extrabold text-slate-900 leading-tight">Mega Texno</h1>
                    </div>
                    <p id="header-user-info" class="text-[11px] text-slate-500 font-semibold">ADMIN63 · Admin</p>
                </div>
            </div>

            <!-- Top Right Controls -->
            <div class="flex items-center flex-wrap justify-end gap-1.5 sm:gap-2">
                <button onclick="switchTab('ombor-add')" title="Mahsulot qo'shish" class="w-8 h-8 btn-teal rounded-xl font-black text-lg leading-none flex items-center justify-center">+</button>
                <button onclick="openRateModal()" class="px-3 py-1.5 bg-slate-50 hover:bg-slate-100 border border-slate-200/90 rounded-xl text-[11px] sm:text-xs font-semibold text-slate-700 flex items-center gap-1.5 transition shadow-2xs">
                    <span class="w-4 h-4 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center font-bold text-[10px]">$</span>
                    <span>Kurs: <strong id="header-rate" class="text-slate-900">12800</strong></span>
                </button>
                <button onclick="openPasswordModal()" class="px-3 py-1.5 bg-slate-50 hover:bg-slate-100 border border-slate-200/90 rounded-xl text-[11px] sm:text-xs font-semibold text-slate-700 flex items-center gap-1.5 transition shadow-2xs">
                    <i class="fa-solid fa-key text-amber-500 text-[10px]"></i>
                    <span>Parol</span>
                </button>
                <button onclick="logoutUser()" class="px-3 py-1.5 bg-slate-50 hover:bg-red-50 hover:text-red-600 hover:border-red-200 border border-slate-200/90 rounded-xl text-[11px] sm:text-xs font-semibold text-slate-700 flex items-center gap-1.5 transition">
                    <i class="fa-solid fa-right-from-bracket text-[10px]"></i>
                    <span class="hidden xs:inline">Chiqish</span>
                </button>
            </div>
        </header>

        <!-- MAIN BODY CONTAINER -->
        <main class="p-3.5 sm:p-6 flex-1 space-y-5 max-w-6xl w-full mx-auto pb-24 md:pb-10">

            <!-- ================= 1. BOSH (DASHBOARD) ================= -->
            <section id="tab-bosh" class="space-y-5">
                <!-- Hero Kassa Card -->
                <div class="hero-kassa rounded-2xl p-5 sm:p-6 text-white shadow-lg">
                    <div class="flex flex-wrap items-start justify-between gap-4 relative z-10">
                        <div class="space-y-2">
                            <div class="flex items-center gap-2 text-xs text-slate-300 font-medium">
                                <span class="w-6 h-6 rounded-lg bg-amber-400/20 text-amber-300 flex items-center justify-center">
                                    <i class="fa-solid fa-wallet text-xs"></i>
                                </span>
                                <span>Umumiy kassa (Mening - sotganlar va narsalar ichida)</span>
                            </div>
                            <div id="dash-kassa-uzs" class="text-2xl sm:text-4xl font-black tracking-tight">
                                0 so'm
                            </div>
                            <div class="pt-1 flex flex-wrap items-center gap-2">
                                <span class="inline-flex items-center gap-1.5 bg-emerald-500/20 border border-emerald-400/30 text-emerald-300 text-xs font-bold px-3 py-1 rounded-lg">
                                    <i class="fa-solid fa-sack-dollar text-amber-300"></i>
                                    <span id="dash-ombor-badge">Jami aktiv: ≈ $0.0 (Kurs: 12800)</span>
                                </span>
                            </div>
                        </div>

                        <div class="flex items-center gap-2">
                            <select id="dash-period-filter" onchange="renderDashboard()" class="bg-white/10 hover:bg-white/15 border border-white/20 text-white text-xs font-semibold px-3.5 py-2 rounded-xl focus:outline-none cursor-pointer">
                                <option value="all" class="text-slate-900">Barcha vaqt</option>
                                <option value="today" class="text-slate-900">Bugun</option>
                                <option value="month" class="text-slate-900">Shu oy</option>
                            </select>
                        </div>
                    </div>
                </div>

                <!-- 5 Metric Cards Grid -->
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3.5">
                    <div class="stat-card p-4 shadow-2xs flex items-center gap-3.5">
                        <div class="w-11 h-11 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center text-lg flex-shrink-0">
                            <i class="fa-solid fa-bolt"></i>
                        </div>
                        <div class="min-w-0">
                            <div class="text-[11px] text-slate-400 font-semibold">Bugungi savdo</div>
                            <div id="stat-today-sales" class="text-base font-extrabold text-slate-900 truncate">0 so'm</div>
                        </div>
                    </div>

                    <div class="stat-card p-4 shadow-2xs flex items-center gap-3.5">
                        <div class="w-11 h-11 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center text-lg flex-shrink-0">
                            <i class="fa-solid fa-calendar-check"></i>
                        </div>
                        <div class="min-w-0">
                            <div class="text-[11px] text-slate-400 font-semibold">Oylik savdo</div>
                            <div id="stat-month-sales" class="text-base font-extrabold text-slate-900 truncate">0 so'm</div>
                        </div>
                    </div>

                    <div class="stat-card p-4 shadow-2xs flex items-center gap-3.5">
                        <div class="w-11 h-11 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-lg flex-shrink-0">
                            <i class="fa-solid fa-arrow-trend-up"></i>
                        </div>
                        <div class="min-w-0">
                            <div class="text-[11px] text-slate-400 font-semibold">Oylik sof foyda</div>
                            <div id="stat-month-profit" class="text-base font-extrabold text-emerald-700 truncate">0 so'm</div>
                        </div>
                    </div>

                    <div class="stat-card p-4 shadow-2xs flex items-center gap-3.5">
                        <div class="w-11 h-11 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center text-lg flex-shrink-0">
                            <i class="fa-solid fa-user-clock"></i>
                        </div>
                        <div class="min-w-0">
                            <div class="text-[11px] text-slate-400 font-semibold">Mijozlar qarzi</div>
                            <div id="stat-cust-debt" class="text-base font-extrabold text-amber-600 truncate">0 so'm</div>
                        </div>
                    </div>

                    <div class="stat-card p-4 shadow-2xs flex items-center gap-3.5">
                        <div class="w-11 h-11 rounded-xl bg-red-50 text-red-600 flex items-center justify-center text-lg flex-shrink-0">
                            <i class="fa-solid fa-scale-unbalanced"></i>
                        </div>
                        <div class="min-w-0">
                            <div class="text-[11px] text-slate-400 font-semibold">Bizning qarzimiz</div>
                            <div id="stat-our-debt" class="text-base font-extrabold text-red-600 truncate">0 so'm</div>
                        </div>
                    </div>
                </div>

                <!-- 14 Days Chart & Categories -->
                <div class="grid grid-cols-1 lg:grid-cols-3 gap-4">
                    <div class="stat-card p-5 shadow-2xs lg:col-span-2">
                        <div class="flex items-center justify-between mb-4">
                            <div class="flex items-center gap-2 text-xs font-extrabold text-slate-800">
                                <span class="w-6 h-6 rounded-lg bg-indigo-50 text-indigo-600 flex items-center justify-center">
                                    <i class="fa-solid fa-chart-column"></i>
                                </span>
                                <span>Savdo dinamikasi (Oxirgi 14 kun)</span>
                            </div>
                            <span class="text-[11px] font-medium text-slate-400">Kunlik tushum</span>
                        </div>
                        <div id="chart-14-bars" class="h-36 flex items-end justify-between gap-1.5 pt-4 border-b border-slate-100 px-1"></div>
                        <div id="chart-14-labels" class="flex justify-between text-[10px] font-semibold text-slate-400 pt-2 px-1"></div>
                    </div>

                    <div class="stat-card p-5 shadow-2xs">
                        <div class="flex items-center gap-2 text-xs font-extrabold text-slate-800 mb-3">
                            <span class="w-6 h-6 rounded-lg bg-amber-50 text-amber-500 flex items-center justify-center">
                                <i class="fa-solid fa-layer-group"></i>
                            </span>
                            <span>Kategoriyalar (Shu oy)</span>
                        </div>
                        <div id="dash-categories" class="text-xs text-slate-400 space-y-2">
                            Bu oyda sotuv yo'q
                        </div>
                    </div>
                </div>
            </section>

            <!-- ================= 2. OMBOR ================= -->
            <section id="tab-ombor" class="space-y-4 hidden">
                <div id="ombor-stats" class="grid grid-cols-2 lg:grid-cols-4 gap-3"></div>

                <div class="stat-card p-5 shadow-2xs">
                    <h3 class="text-sm font-extrabold text-slate-800 mb-3">Kategoriyalar</h3>
                    <div class="flex gap-2 mb-3">
                        <input type="text" id="cat-new" placeholder="Yangi kategoriya (Konditsioner, Muzlatgich...)" class="flex-1 px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs font-medium focus:outline-none focus:bg-white focus:border-[#1f8a65]">
                        <button type="button" onclick="addCategory()" class="btn-teal rounded-xl text-xs font-bold px-4 py-2.5">+ Qo'shish</button>
                    </div>
                    <div id="cat-list" class="flex flex-wrap gap-2"></div>
                </div>

                <div class="stat-card p-5 shadow-2xs">
                    <div class="flex flex-wrap items-center justify-between gap-2 mb-4">
                        <h3 class="text-sm font-extrabold text-slate-800">Ombordagi mahsulotlar ro'yxati</h3>
                        <button type="button" onclick="openPrintModal()" class="btn-teal rounded-xl text-xs font-bold px-3.5 py-2 flex items-center gap-2"><i class="fa-solid fa-print"></i><span>Hamma QR-kodlarni chop etish</span></button>
                        <select id="ombor-cat-filter" onchange="renderOmbor()" class="px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs font-medium focus:outline-none"></select>
