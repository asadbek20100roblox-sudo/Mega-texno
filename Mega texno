        let repPeriod = 'month';
        const REP_PERIODS = [['today', 'Bugun'], ['week', '7 kun'], ['month', 'Shu oy'], ['all', 'Hammasi']];
        function setRepPeriod(p) { repPeriod = p; renderHisobot(); }
        function inPeriod(date) {
            if (repPeriod === 'all') return true;
            const d = date || '', today = new Date().toISOString().slice(0, 10);
            if (repPeriod === 'today') return d === today;
            if (repPeriod === 'month') return d.startsWith(today.slice(0, 7));
            const from = new Date(Date.now() - 6 * 86400000).toISOString().slice(0, 10);
            return d >= from && d <= today;
        }
        function barRows(map, color, unit) {
            const rows = Object.entries(map).filter(([, v]) => v).sort((a, b) => b[1] - a[1]);
            if (!rows.length) return `<div class="text-xs text-slate-400 py-2">Ma'lumot yo'q</div>`;
            const max = Math.max(...rows.map(r => Math.abs(r[1])), 1), tot = rows.reduce((a, r) => a + Math.abs(r[1]), 0) || 1;
            return rows.map(([k, v]) => `<div>
                <div class="flex justify-between items-baseline text-xs mb-1"><span class="font-bold text-slate-700 truncate pr-2">${esc(k)}</span><span class="font-extrabold text-slate-900 whitespace-nowrap">${unit ? v + ' ' + unit : formatUZS(v)} <span class="text-slate-400 font-medium">${Math.round(Math.abs(v) / tot * 100)}%</span></span></div>
                <div class="h-2 bg-slate-100 rounded-full overflow-hidden"><div class="h-full rounded-full ${color}" style="width:${Math.max(3, Math.abs(v) / max * 100)}%"></div></div></div>`).join('');
        }

        function renderHisobot() {
            const set = (id, v) => { const el = document.getElementById(id); if (el) el.textContent = v; };
            document.getElementById('rep-period').innerHTML = REP_PERIODS.map(([k, l]) =>
                `<button onclick="setRepPeriod('${k}')" class="px-4 py-2 rounded-xl text-xs font-bold whitespace-nowrap ${repPeriod === k ? 'btn-teal' : 'bg-white border border-slate-200 text-slate-600'}">${l}</button>`).join('');
            set('rep-period-label', '· ' + REP_PERIODS.find(x => x[0] === repPeriod)[1].toLowerCase());

            const methods = { Naqd: 0, Plastik: 0, Click: 0, Payme: 0 }, cats = {}, sellers = {}, prods = {};
            let revenue = 0, gross = 0, count = 0, brakLoss = 0, brakQty = 0, vozQty = 0, vozSum = 0, qaytQty = 0, kirimQty = 0;
            db.sales.filter(x => inPeriod(x.date)).forEach(x => {
                const t = x.type || 'sotuv', amt = Number(x.totalUZS || 0), q = Number(x.qty || 0);
                gross += Number(x.profitUZS || 0);
                if (x.payment !== 'Qarz') { revenue += amt; if (x.payment in methods) methods[x.payment] += amt; }
                if (t === 'sotuv') { count++; sellers[x.seller || "Noma'lum"] = (sellers[x.seller || "Noma'lum"] || 0) + amt; prods[x.name] = (prods[x.name] || 0) + q; }
                if (t === 'sotuv' || t === 'vozvrat') cats[x.category || 'Boshqa'] = (cats[x.category || 'Boshqa'] || 0) + amt;
                if (t === 'vozvrat') { prods[x.name] = (prods[x.name] || 0) - q; vozQty += q; vozSum += -amt; }
                if (t === 'brak') { brakQty += q; brakLoss += -Number(x.profitUZS || 0); }
                if (t === 'qaytarish') qaytQty += q;
                if (t === 'kirim') kirimQty += q;
            });
            const exp = db.expenses.filter(x => inPeriod(x.date)).reduce((a, b) => a + Number(b.amount || 0), 0);
            const stockVal = db.products.reduce((a, p) => a + unitCost(p) * Number(p.qty || 0), 0);
            const debtIn = db.debts.filter(d => d.type === 'customer').reduce((a, d) => a + Number(d.amount || 0), 0);
            const debtOut = db.debts.filter(d => d.type !== 'customer').reduce((a, d) => a + Number(d.amount || 0), 0);

            const net = gross - exp, pe = document.getElementById('rep-profit');
            pe.textContent = formatUZS(net); pe.classList.toggle('text-red-300', net < 0);
            set('rep-sales', formatUZS(revenue)); set('rep-gross', formatUZS(gross)); set('rep-expenses', formatUZS(exp));
            set('rep-count', count + ' ta'); set('rep-stock-val', formatUZS(stockVal));
            set('rep-debt-in', formatUZS(debtIn)); set('rep-debt-out', formatUZS(debtOut));
            document.getElementById('rep-methods').innerHTML = barRows(methods, 'bg-[#1f8a65]');
            document.getElementById('rep-cats').innerHTML = barRows(cats, 'bg-indigo-500');
            document.getElementById('rep-sellers').innerHTML = barRows(sellers, 'bg-amber-500');
            const top = Object.fromEntries(Object.entries(prods).filter(([, v]) => v > 0).sort((a, b) => b[1] - a[1]).slice(0, 5));
            document.getElementById('rep-top').innerHTML = barRows(top, 'bg-rose-500', 'dona');
            const mv = (t, v, sub, cls) => `<div class="p-3 rounded-xl border border-slate-200/80 bg-slate-50"><div class="text-[11px] font-bold ${cls}">${t}</div><div class="text-sm font-extrabold text-slate-900 mt-1">${v}</div><div class="text-[11px] text-slate-400">${sub}</div></div>`;
            document.getElementById('rep-moves').innerHTML =
                mv('Brak', brakQty + ' dona', 'Zarar: ' + formatUZS(brakLoss), 'text-red-600') +
                mv('Vozvrat', vozQty + ' dona', formatUZS(vozSum), 'text-amber-600') +
                mv('Yetkazuvchiga', qaytQty + ' dona', 'qaytarilgan', 'text-violet-600') +
                mv('Kirim', kirimQty + ' dona', 'omborga', 'text-sky-600');
        }

