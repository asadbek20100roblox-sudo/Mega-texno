        let db = loadDB();
        ensureAdminAccount();
        let currentUser = loadSession();
        let rtdbRef = null;
        let isCloudConnected = false;
        let cloudReady = false;       // bulutdan birinchi ma'lumot kelgunча yozmaymiz
