        function uid() { return Date.now().toString(36) + Math.random().toString(36).slice(2, 7); }

        // Compact SHA-256 (parollar ochiq matn bo'lib saqlanmasligi uchun)
        function sha256(s) {
            const K = [], H = [];
            const r = (v, n) => (v >>> n) | (v << (32 - n));
            let p = 0, c = 2;
            while (p < 64) { let pr = true; for (let i = 2; i * i <= c; i++) if (c % i === 0) { pr = false; break; }
                if (pr) { K[p] = (Math.pow(c, 1 / 3) * 4294967296) | 0; if (p < 8) H[p] = (Math.pow(c, .5) * 4294967296) | 0; p++; } c++; }
            const b = unescape(encodeURIComponent(s)); const w = []; let l = b.length * 8;
            for (let i = 0; i < b.length; i++) w[i >> 2] |= b.charCodeAt(i) << (24 - (i % 4) * 8);
            w[l >> 5] |= 0x80 << (24 - l % 32); w[(((l + 64) >> 9) << 4) + 15] = l;
            for (let j = 0; j < w.length; j += 16) {
                const a = H.slice(0), t = [];
                for (let i = 0; i < 64; i++) {
                    if (i < 16) t[i] = w[j + i] | 0;
                    else { const x = t[i - 15], y = t[i - 2];
                        t[i] = (t[i - 16] + (r(x, 7) ^ r(x, 18) ^ (x >>> 3)) + t[i - 7] + (r(y, 17) ^ r(y, 19) ^ (y >>> 10))) | 0; }
                    const e = a[4], ch = (e & a[5]) ^ (~e & a[6]), mj = (a[0] & a[1]) ^ (a[0] & a[2]) ^ (a[1] & a[2]);
                    const t1 = (a[7] + (r(e, 6) ^ r(e, 11) ^ r(e, 25)) + ch + K[i] + t[i]) | 0;
                    const t2 = ((r(a[0], 2) ^ r(a[0], 13) ^ r(a[0], 22)) + mj) | 0;
                    a.unshift((t1 + t2) | 0); a[4] = (a[4] + t1) | 0; a.pop();
                }
                for (let i = 0; i < 8; i++) H[i] = (H[i] + a[i]) | 0;
            }
            return H.map(v => ('00000000' + (v >>> 0).toString(16)).slice(-8)).join('');
        }
        function hashPass(login, pass) { return sha256('mt|' + login.toLowerCase() + '|' + pass); }
        function checkPass(st, pass) {
            if (st.passHash) return st.passHash === hashPass(st.login, pass);
            return st.pass === pass; // eski (ochiq) parol — kirgandan keyin avtomatik shifrlanadi
