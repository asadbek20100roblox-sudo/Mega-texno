        // kutubxona yuklanmasa — zaxira manzildan yuklash
        function loadScriptOnce(url) {
            return new Promise((res, rej) => { const sc = document.createElement('script'); sc.src = url; sc.onload = res; sc.onerror = rej; document.head.appendChild(sc); });
        }
        async function ensureLib(test, urls) {
            if (test()) return true;
            for (const u of urls) { try { await loadScriptOnce(u); if (test()) return true; } catch (e) {} }
            return false;
