        // =====================================================
        //  SKANER
        // =====================================================
        let scanStream = null, scanTimer = null, scanBD = null, scanLastWarn = '', scanLastWarnAt = 0;
        try { if ('BarcodeDetector' in window) scanBD = new BarcodeDetector({ formats: ['qr_code'] }); } catch (e) { scanBD = null; }

        function setScanStatus(msg, bad) {
            const el = document.getElementById('scan-status');
            el.textContent = msg;
            el.className = 'text-sm font-bold leading-snug ' + (bad ? 'text-amber-300' : 'text-white');
        }
        function stopStream() {
            clearTimeout(scanTimer); scanTimer = null;
            if (scanStream) { scanStream.getTracks().forEach(t => t.stop()); scanStream = null; }
            const v = document.getElementById('scan-video');
            if (v) v.srcObject = null;
        }
        function closeScanner() { stopStream(); document.getElementById('scan-modal').classList.add('hidden'); }
        document.addEventListener('visibilitychange', () => { if (document.hidden && scanStream) closeScanner(); });

        async function openScanner() {
            document.getElementById('scan-modal').classList.remove('hidden');
            await startCamera();
        }

        async function startCamera() {
            stopStream();
            setScanStatus('Kamera ochilmoqda...');
            if (!window.isSecureContext || !navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
                setScanStatus("Kamera bu yerda ochilmaydi: sayt https:// orqali ochilishi kerak (yoki Chrome/Safari brauzerida oching). Pastdagi «Rasmga olish» tugmasi bilan ham skanerlash mumkin.", true);
                return;
            }
            if (!scanBD) await ensureLib(() => typeof jsQR !== 'undefined', LIB_JSQR);
            try {
                let stream;
                try {
                    stream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: { ideal: 'environment' }, width: { ideal: 1280 }, height: { ideal: 720 } }, audio: false });
                } catch (e1) {
                    if (e1 && (e1.name === 'NotAllowedError' || e1.name === 'SecurityError')) throw e1;
                    stream = await navigator.mediaDevices.getUserMedia({ video: true, audio: false });
                }
                if (document.getElementById('scan-modal').classList.contains('hidden')) { stream.getTracks().forEach(t => t.stop()); return; }
                scanStream = stream;
                const v = document.getElementById('scan-video');
                v.setAttribute('playsinline', ''); v.muted = true;
                v.srcObject = stream;
                await v.play();
                setScanStatus("QR-kodni ramkaga to'g'rilang");
                scanTick();
            } catch (err) {
                stopStream();
                const n = err && err.name;
                setScanStatus(
                    n === 'NotAllowedError' || n === 'SecurityError' ? "Kameraga ruxsat berilmagan. Brauzer manzil qatoridagi 🔒 belgisi orqali kameraga ruxsat bering va «Qayta urinish»ni bosing."
                    : n === 'NotFoundError' || n === 'DevicesNotFoundError' ? "Kamera topilmadi. «Rasmga olish» tugmasidan foydalaning."
                    : n === 'NotReadableError' ? "Kamerani boshqa dastur ishlatyapti. Uni yopib, «Qayta urinish»ni bosing."
                    : "Kamerani ochib bo'lmadi (" + (n || 'xato') + "). «Rasmga olish» tugmasidan foydalaning.", true);
            }
        }

        async function decodeCanvas(c, useBoth) {
            if (scanBD) {
                try { const r = await scanBD.detect(c); if (r && r.length && r[0].rawValue) return r[0].rawValue; }
                catch (e) { scanBD = null; }
            }
            if ((!scanBD || useBoth) && typeof jsQR !== 'undefined') {
                const g = c.getContext('2d', { willReadFrequently: true });
                const img = g.getImageData(0, 0, c.width, c.height);
                const code = jsQR(img.data, c.width, c.height, { inversionAttempts: 'attemptBoth' });
                if (code && code.data) return code.data;
            }
            return null;
        }

        async function scanTick() {
            if (!scanStream) return;
            const v = document.getElementById('scan-video');
            if (v.readyState >= 2 && v.videoWidth) {
                const sc = Math.min(1, 720 / v.videoWidth);
                const c = document.getElementById('scan-canvas');
                c.width = Math.round(v.videoWidth * sc); c.height = Math.round(v.videoHeight * sc);
                c.getContext('2d', { willReadFrequently: true }).drawImage(v, 0, 0, c.width, c.height);
                let text = null;
                try { text = await decodeCanvas(c, false); } catch (e) {}
                if (!scanStream) return;
                if (text && handleScan(text)) return;
            }
            scanTimer = setTimeout(scanTick, 120);
        }

        async function scanFromFile(input) {
            const f = input.files && input.files[0];
            input.value = '';
            if (!f) return;
            setScanStatus("Rasm o'qilmoqda...");
            try {
                if (!scanBD) await ensureLib(() => typeof jsQR !== 'undefined', LIB_JSQR);
                const url = URL.createObjectURL(f);
                const img = await new Promise((res, rej) => { const im = new Image(); im.onload = () => res(im); im.onerror = rej; im.src = url; });
                let text = null;
                for (const maxW of [1600, 900, 2400]) {
                    const sc = Math.min(1, maxW / img.naturalWidth);
                    const c = document.createElement('canvas');
                    c.width = Math.round(img.naturalWidth * sc); c.height = Math.round(img.naturalHeight * sc);
                    c.getContext('2d', { willReadFrequently: true }).drawImage(img, 0, 0, c.width, c.height);
                    text = await decodeCanvas(c, true);
                    if (text) break;
                }
                URL.revokeObjectURL(url);
                if (text) handleScan(text);
                else setScanStatus("QR-kod topilmadi. QR-kodni yaqinroq, aniq va yorug'da suratga oling.", true);
            } catch (e) {
                setScanStatus("Rasmni o'qib bo'lmadi. Qayta urinib ko'ring.", true);
            }
        }

        function scanManual() {
            const v = prompt("Mahsulot kodini kiriting (yorliqdagi katta raqam, masalan 1041):");
            if (v && v.trim()) handleScan(v.trim());
        }

        function handleScan(text) {
            text = String(text).trim();
            let p = null, msg = '';
            if (text.startsWith(QR_PREFIX)) {
                p = db.products.find(x => x.id === text.slice(QR_PREFIX.length));
                if (!p) msg = "Mahsulot topilmadi (o'chirilgan bo'lishi mumkin)";
            } else if (/^\d{3,6}$/.test(text)) {
                p = db.products.find(x => String(x.code) === text);
                if (!p) msg = text + " kodli mahsulot topilmadi";
            } else msg = "Bu QR-kod Mega Texnoga tegishli emas";
            if (p) { closeScanner(); applyScannedProduct(p); return true; }
            const now = Date.now();
            if (msg !== scanLastWarn || now - scanLastWarnAt > 2500) { setScanStatus(msg, true); scanLastWarn = msg; scanLastWarnAt = now; }
            return false;
        }

        function scanBeep() {
            try {
                if (navigator.vibrate) navigator.vibrate(80);
                const ac = new (window.AudioContext || window.webkitAudioContext)();
                const o = ac.createOscillator(), gn = ac.createGain();
                o.type = 'sine'; o.frequency.value = 1000; gn.gain.value = 0.15;
                o.connect(gn); gn.connect(ac.destination);
                o.start(); o.stop(ac.currentTime + 0.12);
                setTimeout(() => ac.close(), 400);
            } catch (e) {}
        }

        function applyScannedProduct(p) {
            scanBeep();
            const sel = document.getElementById('s-product'), qty = document.getElementById('s-qty');
            const same = sel.value === p.id;
            sel.value = p.id;
            qty.value = same ? (parseInt(qty.value) || 1) + 1 : 1;
            onSelectSaleProduct();
            const focusEl = hasMoney(moveType) ? document.getElementById('s-price') : qty;
            [sel, qty, focusEl].forEach(el => { el.classList.remove('flash-field'); void el.offsetWidth; el.classList.add('flash-field'); });
            focusEl.scrollIntoView({ block: 'center', behavior: 'smooth' });
            setTimeout(() => { try { focusEl.focus(); focusEl.select && focusEl.select(); } catch (e) {} }, 250);
            const out = MOVE_TYPES[moveType].sign < 0 && !(p.qty > 0);
            showToast(out ? `${p.name} — omborda qolmagan!` : `✓ ${p.name}${same ? ' (+1)' : ''} — ${hasMoney(moveType) ? 'narx va kim sotganini kiriting' : 'sonini kiriting'}`);
        }

        window.addEventListener('DOMContentLoaded', () => {
            setMoveType('sotuv');
            initFirebaseRTDBSync();
            if (currentUser) {
                document.getElementById('login-screen').classList.add('hidden');
            } else {
                document.getElementById('login-screen').classList.remove('hidden');
            }
            renderAll();
        });
    </script>
</body>
</html>
