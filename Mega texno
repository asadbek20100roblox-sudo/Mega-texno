        // ---- QR rasm ----
        function qrToCanvas(text, size) {
            const qr = qrcode(0, 'M');
            qr.addData(text, 'Byte');
            qr.make();
            const n = qr.getModuleCount(), quiet = 3;
            const mod = Math.max(2, Math.floor(size / (n + quiet * 2)));
            const px = mod * (n + quiet * 2);
            const c = document.createElement('canvas');
            c.width = c.height = px;
            const g = c.getContext('2d');
            g.fillStyle = '#fff'; g.fillRect(0, 0, px, px);
            g.fillStyle = '#000';
            for (let r = 0; r < n; r++) for (let k = 0; k < n; k++) {
                if (qr.isDark(r, k)) g.fillRect((k + quiet) * mod, (r + quiet) * mod, mod, mod);
            }
            return c;
        }

        const FONT = 'Arial, Helvetica, sans-serif';
        function fitText(g, text, maxW, startPx, minPx, weight) {
            let fs = Math.max(minPx, startPx);
            g.font = `${weight} ${fs}px ${FONT}`;
            while (g.measureText(text).width > maxW && fs > minPx) { fs -= 1; g.font = `${weight} ${fs}px ${FONT}`; }
            if (g.measureText(text).width > maxW) {
                let t = text;
                while (t.length > 1 && g.measureText(t + '…').width > maxW) t = t.slice(0, -1);
                text = t + '…';
            }
            return { text, fs };
        }
        const todayStr = () => new Date().toLocaleDateString('ru-RU');

        // Yorliq: tepada nomi, chiziq, chapda katta raqam + sana, o'ngda QR
        function labelCanvas(p, w, h, ppm) {
            ppm = ppm || 16;
            const W = Math.round(w * ppm), H = Math.round(h * ppm);
            const c = document.createElement('canvas'); c.width = W; c.height = H;
            const g = c.getContext('2d');
            g.fillStyle = '#fff'; g.fillRect(0, 0, W, H);
            g.fillStyle = '#000'; g.textBaseline = 'middle'; g.textAlign = 'left';
            const pad = Math.min(2.2, w * 0.045) * ppm;
            const headH = h * 0.2 * ppm, headTop = pad * 0.6;
            const nm = fitText(g, p.name || '', W - 2 * pad, headH * 0.62, headH * 0.34, '600');
            g.font = `600 ${nm.fs}px ${FONT}`;
            g.fillText(nm.text, pad, headTop + headH / 2);
            const ruleY = headTop + headH + 0.4 * ppm, ruleH = Math.max(2, Math.round(0.3 * ppm));
            g.fillRect(pad, ruleY, W - 2 * pad, ruleH);
            const bodyTop = ruleY + ruleH + 0.8 * ppm, bodyBot = H - pad * 0.7, bodyH = bodyBot - bodyTop;
            const qc = qrToCanvas(qrPayload(p), Math.min(bodyH, W * 0.5));
            const qrX = W - pad * 0.5 - qc.width;
            g.imageSmoothingEnabled = false;
            g.drawImage(qc, qrX, bodyTop + (bodyH - qc.height) / 2);
            const leftW = qrX - pad - 0.5 * ppm;
            const code = String(p.code || '');
            const cf = fitText(g, code, leftW, bodyH * 0.36, bodyH * 0.18, '800');
            g.fillStyle = '#000'; g.font = `800 ${cf.fs}px ${FONT}`;
            g.fillText(cf.text, pad, bodyTop + bodyH * 0.5);
            const df = fitText(g, todayStr(), leftW, bodyH * 0.14, bodyH * 0.09, '400');
            g.fillStyle = '#555'; g.font = `400 ${df.fs}px ${FONT}`;
            g.fillText(df.text, pad, bodyBot - df.fs * 0.6);
            return c;
        }

