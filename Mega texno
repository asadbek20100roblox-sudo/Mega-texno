        const LIB_QRGEN = ['https://cdn.jsdelivr.net/npm/qrcode-generator@1.4.4/qrcode.js'];
        const LIB_JSQR = ['https://cdn.jsdelivr.net/npm/jsqr@1.4.0/dist/jsQR.js'];
