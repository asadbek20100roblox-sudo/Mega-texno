        // Faqat o'zgargan maydonlarni yozadi → bir vaqtda ishlayotgan telefonlar bir-birini o'chirmaydi
        function buildUpdates() {
            const cur = snapshotOf(db), up = {}, inc = firebase.database.ServerValue.increment;
            if (cur.exchangeRate !== lastSynced.exchangeRate) up['meta/exchangeRate'] = cur.exchangeRate;
            if (cur.catsSeeded && !lastSynced.catsSeeded) up['meta/catsSeeded'] = true;
            COLS.forEach(c => {
                const o = lastSynced[c] || {}, n = cur[c];
                Object.keys(o).forEach(id => { if (!n[id]) up[`${c}/${id}`] = null; });
                Object.keys(n).forEach(id => {
                    if (!o[id]) { up[`${c}/${id}`] = n[id]; return; }
                    Object.keys(n[id]).forEach(f => {
                        if (JSON.stringify(n[id][f]) === JSON.stringify(o[id][f])) return;
                        if (c === 'products' && f === 'qty' && typeof n[id][f] === 'number' && typeof o[id][f] === 'number') up[`${c}/${id}/${f}`] = inc(n[id][f] - o[id][f]);
                        else up[`${c}/${id}/${f}`] = n[id][f];
                    });
                    Object.keys(o[id]).forEach(f => { if (!(f in n[id])) up[`${c}/${id}/${f}`] = null; });
                });
            });
            return { up, cur };
        }

        function saveDB() {
            try { localStorage.setItem(DB_KEY, JSON.stringify(db)); } catch (e) {}
            if (isCloudConnected && rtdbRef && cloudReady) {
                const { up, cur } = buildUpdates();
                if (Object.keys(up).length) {
                    lastSynced = cur;
                    rtdbRef.update(up).catch(err => {
                        console.error('RTDB save error:', err);
                        showToast("Bulutga saqlashda xatolik: " + (err.code || err.message));
                    });
                }
            }
            renderAll();
        }

        function fromCloud(v) {
            const out = { exchangeRate: (v.meta && v.meta.exchangeRate) || db.exchangeRate, catsSeeded: !!(v.meta && v.meta.catsSeeded) };
            COLS.forEach(c => { out[c] = Object.keys(v[c] || {}).map(id => Object.assign({ id }, v[c][id])); });
            return out;
        }

        async function migrateLegacyIfNeeded(root) {
            // Bulut bo'sh bo'lsa: avval eski blob'dan, bo'lmasa shu qurilmadagi ma'lumotdan to'ldiramiz
            let src = null;
            try {
                const old = (await root.root.child(LEGACY_PATH).once('value')).val();
                if (old) src = { exchangeRate: old.exchangeRate, ...Object.fromEntries(COLS.map(c => [c, Array.isArray(old[c]) ? old[c].filter(Boolean) : Object.values(old[c] || {})])) };
            } catch (e) {}
            if (!src) src = db;
            const up = {}, s = snapshotOf(Object.assign({}, db, src));
            COLS.forEach(c => Object.keys(s[c]).forEach(id => { up[`${c}/${id}`] = s[c][id]; }));
            up['meta/exchangeRate'] = s.exchangeRate || 12800;
            await root.update(up);
        }

        // ================= FIREBASE REALTIME DATABASE ENGINE =================
        function initFirebaseRTDBSync() {
            const config = DEFAULT_FIREBASE_CONFIG;
            if (typeof firebase === 'undefined') return;
            try {
                if (!firebase.apps.length) firebase.initializeApp(config);
                const database = firebase.database();
                rtdbRef = database.ref(CLOUD_ROOT);
                isCloudConnected = true;

                rtdbRef.on('value', async snap => {
                    const v = snap.val();
                    if (!v || !COLS.some(c => v[c])) {
                        if (!cloudReady) { try { await migrateLegacyIfNeeded(rtdbRef); } catch (e) { console.error(e); showToast("Bulutni boshlashda xatolik: " + (e.code || e.message)); } cloudReady = true; }
                        else { COLS.forEach(c => db[c] = []); lastSynced = snapshotOf(db); }
                        if (cloudReady && v === null) return;
                    }
                    if (v) {
                        const incoming = fromCloud(v);
                        db = Object.assign(db, incoming);
                        lastSynced = snapshotOf(incoming);
                        ensureAdminAccount();
                        cloudReady = true;
                        // admin hisobi bulutda yo'q bo'lsa — qo'shamiz
                        const { up, cur } = buildUpdates();
                        if (Object.keys(up).length) { lastSynced = cur; rtdbRef.update(up); }
                        try { localStorage.setItem(DB_KEY, JSON.stringify(db)); } catch (e) {}
                        // bloklangan yoki o'chirilgan xodim darhol chiqarib yuboriladi
                        if (currentUser) {
                            const me = db.staff.find(s => s.login === currentUser.login);
                            if (!me || me.blocked) logoutUser();
                        }
                        renderAll();
                    }
                }, error => {
                    console.error("RTDB sync error:", error);
                    showToast("Bulutga ulanib bo'lmadi: " + (error.code || error.message));
                });
            } catch (err) {
                console.error("RTDB init failed:", err);
            }
        }

